# Generate: openssl rand -hex 32
ACCESS_TOKEN=
PUBLIC_ORIGIN=http://localhost:8080
MAX_CLIENTS=8
# For public HTTPS deployment set both:
# DOMAIN=proxy.example.com
# PUBLIC_ORIGIN=https://proxy.example.com

# Explicit destination-TLS trust mode. Restart the app and reopen the control page to change.
TLS_MODE=gateway
# TLS_MODE=browser uses isolated Epoxy workers and the Wisp TCP compatibility endpoint.
WS_LIFETIME_MS=0
WS_IDLE_MS=300000
